# Use development locally. Production enables strict configuration validation.
APP_ENV=development
DATABASE_URL=sqlite:///./routealpha.sqlite3
OPENROUTER_API_KEY=your_openrouter_api_key_here
AUTH_SECRET_KEY=replace_with_a_long_random_secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. In local development it is safely derived from AUTH_SECRET_KEY.
TOTP_ENCRYPTION_KEY=
AUTH_TOKEN_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
ENFORCE_HTTPS=false
# Local-only convenience. Production must set false and run `python -m alembic upgrade head`.
AUTO_CREATE_SCHEMA=true
# Required in production; use a Redis URI shared by every API instance.
RATE_LIMIT_STORAGE_URI=memory://
TELEMETRY_REDIS_URL=
# Required in production. Use a long random value; monitoring scrapers send it
# as the X-Metrics-Token header to GET /internal/metrics.
METRICS_TOKEN=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Bound each provider call and protect the API from unbounded upstream work.
MODEL_REQUEST_TIMEOUT_SECONDS=30
MAX_INFERENCE_CONCURRENCY=20
INFERENCE_QUEUE_TIMEOUT_SECONDS=5
# Public/API abuse controls. Production stores these counters in Redis.
REGISTER_RATE_LIMIT=5/hour
CONTACT_RATE_LIMIT=10/hour
INFERENCE_RATE_LIMIT=60/minute
# Set these to models validated against the deployed OpenRouter account.
MODEL_CHEAP=openrouter/google/gemini-3.5-flash-lite
MODEL_MEDIUM=openrouter/openai/gpt-4o-mini
MODEL_STRONG=openrouter/openai/gpt-4o
# Prices per 1K tokens. These must match the deployed provider contract and are
# required with APP_ENV=production. Development values are example-only.
MODEL_CHEAP_INPUT_PER_1K=0.00030
MODEL_CHEAP_OUTPUT_PER_1K=0.00250
MODEL_MEDIUM_INPUT_PER_1K=0.00015
MODEL_MEDIUM_OUTPUT_PER_1K=0.00060
MODEL_STRONG_INPUT_PER_1K=0.00250
MODEL_STRONG_OUTPUT_PER_1K=0.01000
CONTACT_NOTIFICATION_EMAIL=ops@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_SENDER_EMAIL=your_gmail_address@gmail.com
